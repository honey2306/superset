{
	"name": "@superset/host-contract",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/router.generated.ts"
		},
		"./router": {
			"types": "./src/router.generated.ts"
		},
		"./catalog": {
			"types": "./src/catalog.ts",
			"default": "./src/catalog.ts"
		},
		"./provisioning": {
			"types": "./src/provisioning.ts",
			"default": "./src/provisioning.ts"
		},
		"./provisioning-schemas": {
			"types": "./src/provisioning-schemas.ts",
			"default": "./src/provisioning-schemas.ts"
		},
		"./events": {
			"types": "./src/events.ts",
			"default": "./src/events.ts"
		},
		"./errors": {
			"types": "./src/errors.ts",
			"default": "./src/errors.ts"
		},
		"./settings": {
			"types": "./src/settings.ts",
			"default": "./src/settings.ts"
		},
		"./runs": {
			"types": "./src/runs.ts",
			"default": "./src/runs.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@superset/port-scanner": "workspace:*",
		"@superset/session-protocol": "workspace:*",
		"@superset/shared": "workspace:*",
		"@superset/workspace-fs": "workspace:*",
		"@trpc/server": "11.16.0",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@superset/typescript": "workspace:*",
		"typescript": "6.0.3"
	}
}
