{
	"name": "@superset/cli",
	"version": "2.3.1",
	"private": true,
	"type": "module",
	"bin": {
		"superset": "./src/index.ts"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"build": "bun build --compile --minify-whitespace src/index.ts --outfile dist/superset",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false",
		"test": "bun test",
		"dev": "bun run src/index.ts"
	},
	"dependencies": {
		"@superset/host-service": "workspace:*",
		"@superset/session-protocol": "workspace:*",
		"@superset/shared": "workspace:*",
		"@trpc/client": "11.16.0",
		"cli-highlight": "2.1.11",
		"marked": "18.0.5",
		"superjson": "2.2.6"
	},
	"devDependencies": {
		"@superset/typescript": "workspace:*",
		"bun-types": "1.3.14",
		"typescript": "6.0.3"
	}
}
