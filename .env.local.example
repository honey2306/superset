# Local-first Desktop development
#
# Usually you should run `./.superset/setup.local.sh`; it allocates per-worktree
# ports and writes `.env`. This template is sufficient for a single checkout.

SUPERSET_WORKSPACE_NAME=superset
SUPERSET_HOME_DIR=./superset-dev-data
SUPERSET_PORT_BASE=3000
DESKTOP_VITE_PORT=3005
DESKTOP_NOTIFICATIONS_PORT=3006

# Public links shown by the Desktop UI.
NEXT_PUBLIC_WEB_URL=https://superset.sh
NEXT_PUBLIC_MARKETING_URL=https://superset.sh
NEXT_PUBLIC_DOCS_URL=https://docs.superset.sh

# Optional diagnostics. Leave blank to disable in local development.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN_DESKTOP=
