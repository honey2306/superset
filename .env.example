# Desktop build/development environment
# For a local checkout, prefer `./.superset/setup.local.sh`.

SUPERSET_WORKSPACE_NAME=superset
SUPERSET_HOME_DIR=./superset-dev-data
DESKTOP_VITE_PORT=5173
DESKTOP_NOTIFICATIONS_PORT=51741

# Public links shown by the Desktop UI.
NEXT_PUBLIC_WEB_URL=https://superset.sh
NEXT_PUBLIC_MARKETING_URL=https://superset.sh
NEXT_PUBLIC_DOCS_URL=https://docs.superset.sh

# Optional analytics and error reporting.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_AUTH_TOKEN=
SENTRY_DSN_DESKTOP=
