      {
        "selector": "JSXOpeningElement[name.name='Breadcrumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|onClick|className|key|ref|style|children)$/]",
        "message": "<Breadcrumb> doesn't accept that prop. Declared props: items, onClick, className."
