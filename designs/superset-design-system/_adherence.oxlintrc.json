{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/Badge/**",
              "components/core/Button/**",
              "components/core/Chip/**",
              "components/core/Divider/**",
              "components/core/Icon/**",
              "components/core/IconButton/**",
              "components/core/Kbd/**",
              "components/core/Pill/**",
              "components/core/Tag/**",
              "components/data/Avatar/**",
              "components/data/ScrollArea/**",
              "components/data/Table/**",
              "components/feedback/Alert/**",
              "components/feedback/ConfirmCard/**",
              "components/feedback/Empty/**",
              "components/feedback/Progress/**",
              "components/feedback/Skeleton/**",
              "components/feedback/Spinner/**",
              "components/feedback/Toast/**",
              "components/forms/Checkbox/**",
              "components/forms/Input/**",
              "components/forms/Label/**",
              "components/forms/Radio/**",
              "components/forms/SegmentedControl/**",
              "components/forms/Slider/**",
              "components/forms/Switch/**",
              "components/forms/Textarea/**",
              "components/navigation/Breadcrumb/**",
              "components/navigation/Collapsible/**",
              "components/navigation/FileRow/**",
              "components/navigation/Tabs/**",
              "components/navigation/WorkspaceItem/**",
              "components/overlays/AlertDialog/**",
              "components/overlays/ContextMenu/**",
              "components/overlays/Dialog/**",
              "components/overlays/DropdownMenu/**",
              "components/overlays/HoverCard/**",
              "components/overlays/Popover/**",
              "components/overlays/Sheet/**",
              "components/overlays/Tooltip/**",
              "ui_kits/desktop-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|children|className|key|ref|style)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: tone, title, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|success|warning|danger)$/]",
        "message": "<Alert> tone must be one of 'info' | 'success' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertDialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|body|confirmLabel|cancelLabel|onConfirm|onCancel|key|ref|className|style|children)$/]",
        "message": "<AlertDialog> doesn't accept that prop. Declared props: open, title, body, confirmLabel, cancelLabel, onConfirm, onCancel."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|className|key|ref|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, size, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|pill|children|className|key|ref|style)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, pill, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:add|mod|del)$/]",
        "message": "<Badge> tone must be one of 'add' | 'mod' | 'del'."
