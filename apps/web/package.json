		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-router-dom": "7.9.5",
		"superjson": "2.2.6",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@superset/typescript": "workspace:*",
		"@tailwindcss/vite": "4.2.2",
		"@types/node": "24.12.0",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.2.0",
