#!/bin/bash
# Superset agent-wrapper v3
# Superset wrapper for copilot

find_real_binary() {
  local name="$1"
  local IFS=:
  for dir in $PATH; do
    [ -z "$dir" ] && continue
    dir="${dir%/}"
    case "$dir" in
      "/Users/wufan/.codex/worktrees/99c0/superset/superset-dev-data-fusion/bin"|"$HOME"/.superset/bin|"$HOME"/.superset-*/bin) continue ;;
    esac
    if [ -x "$dir/$name" ] && [ ! -d "$dir/$name" ]; then
      printf "%s\n" "$dir/$name"
      return 0
    fi
  done
  return 1
}

REAL_BIN="$(find_real_binary "copilot")"
if [ -z "$REAL_BIN" ]; then
  echo "Superset: copilot not found in PATH. Install it and ensure it is on PATH, then retry." >&2
  exit 127
fi

export SUPERSET_AGENT_ID="copilot"

# Copilot CLI only supports project-level hooks (.github/hooks/*.json in CWD).
# Auto-inject Superset notification hooks when running inside a v2 Superset terminal.
if [ -n "$SUPERSET_TERMINAL_ID" ] && [ -f "/Users/wufan/.codex/worktrees/99c0/superset/superset-dev-data-fusion/hooks/copilot-hook.sh" ]; then
  COPILOT_HOOKS_DIR=".github/hooks"
  COPILOT_HOOK_FILE="$COPILOT_HOOKS_DIR/superset-notify.json"

  # Always refresh our dedicated hook file so stale absolute hook paths from
  # older installs/workspaces cannot silently break notifications.
  mkdir -p "$COPILOT_HOOKS_DIR" 2>/dev/null
  printf '%s\n' '{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "/Users/wufan/.codex/worktrees/99c0/superset/superset-dev-data-fusion/hooks/copilot-hook.sh sessionStart",
        "timeoutSec": 5
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "/Users/wufan/.codex/worktrees/99c0/superset/superset-dev-data-fusion/hooks/copilot-hook.sh sessionEnd",
        "timeoutSec": 5
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "/Users/wufan/.codex/worktrees/99c0/superset/superset-dev-data-fusion/hooks/copilot-hook.sh userPromptSubmitted",
        "timeoutSec": 5
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "/Users/wufan/.codex/worktrees/99c0/superset/superset-dev-data-fusion/hooks/copilot-hook.sh postToolUse",
        "timeoutSec": 5
      }
    ]
  }
}' > "$COPILOT_HOOK_FILE" 2>/dev/null

  if [ -d ".git/info" ]; then
    grep -qF ".github/hooks/superset-notify.json" ".git/info/exclude" 2>/dev/null || \
      printf '%s\n' ".github/hooks/superset-notify.json" >> ".git/info/exclude" 2>/dev/null
  fi
fi

exec "$REAL_BIN" "$@"
